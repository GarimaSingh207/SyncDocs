# ==============================================================================
# SyncDocs Backend Production Environment Variables Configuration Template
# Copy or rename this file to '.env' inside the backend directory on your server.
# ==============================================================================

# Node Environment Mode ('production' or 'development')
NODE_ENV=production

# HTTP Application Server Port
PORT=5000

# PostgreSQL Database Connection URL (AWS RDS PostgreSQL or EC2 Local PostgreSQL)
# Replace placeholder values with your actual AWS RDS connection details:
DATABASE_URL="postgresql://<DB_USER>:<DB_PASSWORD>@<RDS_ENDPOINT>:5432/<DB_NAME>?schema=public&connection_limit=10&sslmode=prefer"

# JWT Secret Key (Replace placeholder with a secure 64-character random string)
# Example generation command: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_production_jwt_secret_key_here
