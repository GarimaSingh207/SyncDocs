# ==============================================================================
# SyncDocs Frontend Production Environment Variables Configuration Template
# Rename or copy this file to '.env' inside the frontend directory before building.
# Note: Vite injects these variables at BUILD TIME (npm run build).
# ==============================================================================

# Backend Public API Endpoint
# Option A (IP-based): http://<YOUR_EC2_PUBLIC_IP>/api
# Option B (Domain-based): https://syncdocs.yourdomain.com/api
VITE_API_URL=http://<YOUR_EC2_PUBLIC_IP_OR_DOMAIN>/api
